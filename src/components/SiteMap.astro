---
import PageTitle from './PageTitle.astro';
import Layout from '../layouts/Layout.astro';
import type { SiteCopy } from '../i18n/ui';
import { postSlug, postsByLocale } from '../lib/blog';
import { pageUrl, siteGroups } from '../lib/sitemap';

interface Props {
	copy: SiteCopy;
}

const { copy } = Astro.props;
const posts = await postsByLocale(copy.locale);
const groups = siteGroups(copy);
---

<Layout copy={copy} title={copy.siteMapLabel} description={copy.siteMapLead}>
	<div class="wrap pt-14 pb-20 lg:pt-20 lg:pb-28">
		<PageTitle lines={copy.siteMapTitle} />
		<p class="lead mt-8 max-w-2xl">{copy.siteMapLead}</p>
		<div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
			{
				groups.map((group) => (
					<section class="border-t-2 border-navy pt-5">
						<h2 class="text-2xl font-semibold tracking-tight text-blue">{group.heading}</h2>
						<ul class="mt-4 grid gap-2.5 text-lg font-medium">
							{group.links.map((link) => (
								<li>
									<a
										class="footer-link"
										href={link.href}
										target={link.external ? '_blank' : undefined}
										rel={link.external ? 'noopener' : undefined}
									>
										{link.label}
										{link.external && <span class="sr-only"> {copy.opensInNewTab}</span>}
									</a>
									{link.page === 'blogi' && posts.length > 0 && (
										<ul class="mt-2.5 grid gap-2 border-l border-navy/25 pl-4 text-[0.9375rem] font-normal">
											{posts.map((post) => (
												<li>
													<a class="footer-link" href={pageUrl(copy, 'blogi', postSlug(post))}>
														{post.data.title}
													</a>
												</li>
											))}
										</ul>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</Layout>
