---
import Button from './Button.astro';
import CtaBand from './CtaBand.astro';
import TickBand from './TickBand.astro';
import Layout from '../layouts/Layout.astro';
import { discordInviteUrl, whatsappInviteUrl, type SiteCopy } from '../i18n/ui';
import { pageUrl } from '../lib/sitemap';

interface Props {
	copy: SiteCopy;
}

const { copy } = Astro.props;
const { purpose, activity, audience, membership, discord } = copy.sections;
const [network, ...otherActivities] = copy.activities;
---

<Layout copy={copy}>
	<section>
		<div
			class="wrap grid items-center gap-10 pt-14 pb-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(16rem,0.85fr)] lg:pt-20 lg:pb-24"
		>
			<div>
				<p class="text-sm font-semibold text-blue">{copy.heroEyebrow}</p>
				<h1
					class="mt-4 max-w-3xl text-balance text-[clamp(2.6rem,6vw,4.6rem)] leading-[1.05] font-semibold tracking-tight"
				>
					{copy.heroTitle}
				</h1>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-navy/80">{copy.heroLead}</p>
				<p class="mt-5 max-w-xl border-l-2 border-teal pl-4 text-lg font-medium">{copy.tagline}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<Button href={`#${membership.id}`}>{copy.ctaPrimary}</Button>
					<Button href={`#${activity.id}`} quiet>{copy.ctaActivity}</Button>
				</div>
			</div>
			<img
				src="/brand/arctic-ai-logo.svg"
				alt={copy.logoAlt}
				width="1381"
				height="830"
				class="mx-auto w-full max-w-md lg:max-w-none"
			/>
		</div>
		<div class="wrap">
			<p class="border-y border-navy/12 py-4 text-lg font-medium">
				<span class="text-blue">{copy.visionLabel}</span>{' '}
				{copy.vision}
			</p>
		</div>
	</section>

	<section id={purpose.id} class="pt-20 lg:pt-28">
		<div class="wrap rail pb-14 lg:pb-20">
			<h2 class="h2">{copy.purposeTitle}</h2>
			<p class="lead max-w-3xl">{copy.purposeBody}</p>
		</div>
		<TickBand rows={copy.pillars} />
	</section>

	<section id={activity.id} class="py-20 lg:py-28">
		<div class="wrap rail">
			<h2 class="h2">{copy.activityTitle}</h2>
			<div>
				<p class="lead max-w-3xl">{copy.activityLead}</p>
				<ul class="mt-10 grid gap-x-10 sm:grid-cols-3">
					<li class="border-t-2 border-navy pt-5 pb-10 sm:col-span-3">
						<h3 class="text-[clamp(2rem,4.4vw,3.25rem)] leading-none font-semibold tracking-tight text-blue">
							{network.title}
						</h3>
						<p class="lead mt-4 max-w-2xl">{network.body}</p>
					</li>
					{
						otherActivities.map((item) => (
							<li class="border-t border-navy/25 pt-5 pb-8">
								<h3 class="text-2xl font-semibold tracking-tight text-blue">{item.title}</h3>
								<p class="mt-2 text-navy/80">{item.body}</p>
							</li>
						))
					}
				</ul>
				<div class="mt-6 border-t border-navy/25 pt-8">
					<p class="text-lg font-medium">{copy.sectorsLead}</p>
					<ul class="checks mt-5 grid gap-x-10 gap-y-3 text-xl font-semibold tracking-tight sm:grid-cols-2">
						{copy.sectors.map((sector) => <li>{sector}</li>)}
					</ul>
				</div>
				<div class="mt-12 flex flex-wrap items-center justify-between gap-x-10 gap-y-5 border-t border-navy/25 pt-8">
					<p class="max-w-md text-lg font-medium">{copy.volunteerBrief}</p>
					<Button href={pageUrl(copy, 'vapaaehtoiset')} quiet>{copy.volunteerLink}</Button>
				</div>
			</div>
		</div>
	</section>

	<section id={audience.id} class="border-t border-navy/12 py-20 lg:py-28">
		<div class="wrap rail">
			<div>
				<h2 class="h2">{copy.audienceTitle}</h2>
				<p class="mt-6 max-w-md text-navy/80">{copy.audienceLead}</p>
			</div>
			<ul class="checks grid gap-x-10 gap-y-8 self-start sm:grid-cols-2">
				{
					copy.audiences.map((item) => (
						<li>
							<h3 class="text-xl leading-snug font-semibold tracking-tight">{item.title}</h3>
							<p class="mt-1.5 text-navy/80">{item.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id={membership.id} class="border-t border-navy/12 pt-20 lg:pt-28">
		<div class="wrap rail pb-14 lg:pb-20">
			<div>
				<h2 class="h2">{copy.membershipTitle}</h2>
				<p class="mt-6 max-w-md text-navy/80">{copy.membershipLead}</p>
				<div class="mt-8">
					<Button href={pageUrl(copy, 'saannot')} quiet>{copy.rulesCta}</Button>
				</div>
			</div>
			<div>
				<table class="w-full text-left">
					<caption class="mb-5 text-left text-xl font-semibold tracking-tight">{copy.feesCaption}</caption>
					<thead>
						<tr class="border-b-2 border-navy text-[0.9375rem] text-navy/72">
							<th scope="col" class="py-2 pr-4 font-medium">{copy.feeClass}</th>
							<th scope="col" class="py-2 text-right font-medium">{copy.feeAmount}</th>
						</tr>
					</thead>
					<tbody>
						{
							copy.fees.map((fee) => (
								<tr class="border-b border-navy/12">
									<th scope="row" class="py-3.5 pr-4 font-medium">
										{fee.label}
										{fee.note && (
											<span class="mt-0.5 block text-[0.9375rem] font-normal text-navy/72">{fee.note}</span>
										)}
									</th>
									<td class="py-3.5 text-right align-top text-xl font-semibold whitespace-nowrap tabular-nums">
										{fee.amount}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p class="mt-5 max-w-2xl text-[0.9375rem] text-navy/72">{copy.membershipNote}</p>
			</div>
		</div>
		<CtaBand href={copy.membershipFormUrl} lines={copy.membershipCta} newTabLabel={copy.opensInNewTab} />
	</section>

	<section id={discord.id} class="py-20 lg:py-28">
		<div class="wrap rail">
			<div>
				<h2 class="h2">{copy.discordTitle}</h2>
				<p class="mt-6 max-w-md text-navy/80">{copy.discordLead}</p>
				{
					copy.discordLanguageNote && (
						<p class="mt-5 max-w-md border-l-2 border-teal pl-4 font-medium">{copy.discordLanguageNote}</p>
					)
				}
				<div class="mt-8 grid max-w-[19rem] gap-3">
					<Button href={discordInviteUrl} arrow newTabLabel={copy.opensInNewTab}>{copy.discordCta}</Button>
					<Button href={whatsappInviteUrl} quiet arrow newTabLabel={copy.opensInNewTab}>{copy.whatsappCta}</Button>
				</div>
			</div>
			<ul class="checks grid gap-y-8 self-start">
				{
					copy.discordPoints.map((point) => (
						<li>
							<h3 class="text-xl leading-snug font-semibold tracking-tight">{point.title}</h3>
							<p class="mt-1.5 text-navy/80">{point.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
