---
import PageTitle from './PageTitle.astro';
import Layout from '../layouts/Layout.astro';
import type { SiteCopy } from '../i18n/ui';
import { palveluSummary, palvelutByKind } from '../lib/palvelut';

interface Props {
	copy: SiteCopy;
}

const { copy } = Astro.props;
const headings = {
	yritys: copy.directoryCompanies,
	julkinen: copy.directoryPublic,
	kumppani: copy.directoryPartners,
};
const groups = (await palvelutByKind())
	.filter((group) => group.entries.length > 0)
	.map((group) => ({
		heading: headings[group.kind],
		entries: group.entries,
	}));
---

<Layout copy={copy} title={copy.directoryPageTitle} description={copy.directoryDescription}>
	<div class="wrap pt-14 pb-20 lg:pt-20 lg:pb-28">
		<PageTitle lines={copy.directoryTitle} />
		<p class="lead mt-8 max-w-2xl">{copy.directoryLead}</p>
		{
			groups.length === 0 ? (
				<p class="mt-12 border-t-2 border-navy pt-6 text-2xl font-semibold tracking-tight">{copy.directoryEmpty}</p>
			) : (
				groups.map((group) => (
					<section class="rail mt-16">
						<h2 class="h2">{group.heading}</h2>
						<ul class="border-t-2 border-navy">
							{group.entries.map((entry) => (
								<li class="border-b border-navy/12">
									<a class="row-link block py-7" href={entry.data.url} target="_blank" rel="noopener">
										<h3 class="row-link__title text-2xl font-semibold tracking-tight text-pretty">
											{entry.data.name}
										</h3>
										<p class="mt-2 max-w-2xl text-pretty text-navy/80">{palveluSummary(entry, copy.locale)}</p>
										<p class="mt-3 font-semibold text-blue">
											{copy.directoryVisit}
											<span class="sr-only"> {copy.opensInNewTab}</span>
										</p>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			)
		}
		<section class="rail mt-16 border-t border-navy/12 pt-12">
			<h2 class="h2">{copy.directoryHowTitle}</h2>
			<p class="lead max-w-2xl self-start">{copy.directoryHow}</p>
		</section>
	</div>
</Layout>
