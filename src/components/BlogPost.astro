---
import { render, type CollectionEntry } from 'astro:content';
import PostKind from './PostKind.astro';
import Layout from '../layouts/Layout.astro';
import type { SiteCopy } from '../i18n/ui';
import { formatPostDate } from '../lib/blog';
import { pageUrl } from '../lib/sitemap';

interface Props {
	copy: SiteCopy;
	post: CollectionEntry<'blogi'>;
}

const { copy, post } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const blogHref = pageUrl(copy, 'blogi');
const partner = post.data.kind === 'partner' ? post.data : null;
const author = partner
	? {
			'@type': 'Organization',
			name: partner.partner,
			...(partner.partnerUrl ? { url: partner.partnerUrl } : {}),
		}
	: {
			'@type': 'Organization',
			name: 'Arctic AI Association ry',
			url: 'https://arcai.fi',
		};
---

<Layout copy={copy} title={post.data.title} description={post.data.description}>
	<article>
		<div class="mx-auto max-w-3xl px-(--gutter) pt-14 pb-20 lg:pt-20 lg:pb-28">
			<p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.9375rem]">
				<a class="link" href={blogHref}>{copy.blogLabel}</a>
				<PostKind copy={copy} post={post} />
				<span class="text-navy/72">
					{copy.publishedLabel}{' '}
					<time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate, copy.locale)}</time>
				</span>
			</p>
			<h1 class="mt-5 text-[clamp(2.2rem,5vw,3.5rem)] leading-[1.05] font-semibold tracking-tight text-balance">
				{post.data.title}
			</h1>
			<p class="lead mt-6 max-w-2xl">{post.data.description}</p>
			<div class="prose prose-arcai mt-12 max-w-none border-t-2 border-navy pt-10">
				<Content />
			</div>
		</div>
	</article>
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: post.data.title,
			datePublished: post.data.pubDate.toISOString().slice(0, 10),
			description: post.data.description,
			inLanguage: copy.htmlLang,
			url: canonical,
			mainEntityOfPage: canonical,
			author,
			publisher: {
				'@type': 'Organization',
				name: 'Arctic AI Association ry',
				url: 'https://arcai.fi',
			},
		})}
	/>
</Layout>
