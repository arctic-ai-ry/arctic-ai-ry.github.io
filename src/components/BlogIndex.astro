---
import PageTitle from './PageTitle.astro';
import PostKind from './PostKind.astro';
import Layout from '../layouts/Layout.astro';
import type { SiteCopy } from '../i18n/ui';
import { formatPostDate, postSlug, postsByLocale, postsOfKind } from '../lib/blog';
import { pageUrl } from '../lib/sitemap';

interface Props {
	copy: SiteCopy;
}

const { copy } = Astro.props;
const posts = await postsByLocale(copy.locale);
const groups = [
	{ heading: copy.blogOwnHeading, posts: postsOfKind(posts, 'association') },
	{ heading: copy.blogPartnerHeading, posts: postsOfKind(posts, 'partner') },
].filter((group) => group.posts.length > 0);
---

<Layout copy={copy} title={copy.blogLabel} description={copy.blogLead}>
	<div class="wrap pt-14 pb-20 lg:pt-20 lg:pb-28">
		<PageTitle lines={copy.blogTitle} max="7.5rem" />
		<p class="lead mt-8 max-w-2xl">{copy.blogLead}</p>
		{
			groups.map((group) => (
				<section class="rail mt-16">
					<h2 class="h2">{group.heading}</h2>
					<ul class="border-t-2 border-navy">
						{group.posts.map((post) => (
							<li class="border-b border-navy/12">
								<a class="row-link block py-7" href={pageUrl(copy, 'blogi', postSlug(post))}>
									<p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.9375rem]">
										<PostKind copy={copy} post={post} linked={false} />
										<span class="text-navy/72">
											{copy.publishedLabel}{' '}
											<time datetime={post.data.pubDate.toISOString()}>
												{formatPostDate(post.data.pubDate, copy.locale)}
											</time>
										</span>
									</p>
									<h3 class="row-link__title mt-3 text-[clamp(1.6rem,3vw,2.25rem)] leading-tight font-semibold tracking-tight text-pretty">
										{post.data.title}
									</h3>
									<p class="mt-3 max-w-2xl text-pretty text-navy/80">{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</Layout>
