---
import type { CollectionEntry } from 'astro:content';
import type { SiteCopy } from '../i18n/ui';

interface Props {
	copy: SiteCopy;
	post: CollectionEntry<'blogi'>;
	linked?: boolean;
}

const { copy, post, linked = true } = Astro.props;
const partner = post.data.kind === 'partner';
const partnerName = partner ? post.data.partner : '';
const partnerUrl = partner ? post.data.partnerUrl : undefined;
---

<span class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold">
	<span class="text-navy">{partner ? copy.blogPartnerLabel : copy.blogOwnLabel}</span>
	{
		partner &&
			(linked && partnerUrl ? (
				<a class="link link--inline" href={partnerUrl}>
					{partnerName}
				</a>
			) : (
				<span class="text-blue">{partnerName}</span>
			))
	}
</span>
