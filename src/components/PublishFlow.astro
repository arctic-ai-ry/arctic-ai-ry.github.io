---
interface Step {
	label: string;
	detail: string;
}

interface Props {
	caption: string;
	steps: Step[];
}

const { caption, steps } = Astro.props;
---

<figure class="not-prose my-10">
	<figcaption class="font-semibold text-blue">{caption}</figcaption>
	<ol class="mt-4 flex flex-col sm:flex-row sm:items-stretch">
		{
			steps.map((step, index) => (
				<li class="flex min-w-0 flex-1 flex-col sm:flex-row">
					<div
						class:list={[
							'h-full w-full border-t-2 py-3 sm:pr-3',
							index === steps.length - 1 ? 'border-teal' : 'border-navy',
						]}
					>
						<p class="font-semibold tabular-nums text-blue">{index + 1}</p>
						<p class="mt-1 font-semibold text-navy">{step.label}</p>
						<p class="mt-1 text-[0.9375rem] leading-snug text-navy/80">{step.detail}</p>
					</div>
					{index < steps.length - 1 && (
						<svg
							class="my-1 h-3 w-6 shrink-0 rotate-90 self-center fill-navy sm:mx-2 sm:my-0 sm:rotate-0"
							viewBox="0 0 64 30"
							aria-hidden="true"
						>
							<path d="M0 10.5H40V1L64 15L40 29V19.5H0Z" />
						</svg>
					)}
				</li>
			))
		}
	</ol>
</figure>
