---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { contactEmail, volunteerFormUrl, type SiteCopy } from '../i18n/ui';

interface Props {
	copy: SiteCopy;
}

const { copy } = Astro.props;
const formReady = volunteerFormUrl.length > 0;
---

<Layout copy={copy} title={copy.volunteerNav} description={copy.volunteerDescription}>
	<section>
		<div class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:px-6 lg:pt-20 lg:pb-24">
			<p class="text-sm font-semibold text-fjord">{copy.heroEyebrow}</p>
			<h1
				class="mt-4 max-w-3xl text-balance text-[clamp(2.4rem,5vw,4.2rem)] leading-[1.05] font-semibold tracking-tight"
			>
				{copy.volunteerTitle}
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{copy.volunteerLead}</p>
			<a
				href={formReady ? volunteerFormUrl : '#ilmoittaudu'}
				target={formReady ? '_blank' : undefined}
				rel={formReady ? 'noopener' : undefined}
				class="mt-8 inline-flex min-h-11 items-center gap-2 bg-ink px-5 text-sm font-semibold text-snow hover:bg-fjord"
			>
				{copy.volunteerCta}
				{
					formReady && (
						<>
							<Icon name="lucide:arrow-up-right" class="size-4 shrink-0" aria-hidden="true" />
							<span class="sr-only">{copy.opensInNewTab}</span>
						</>
					)
				}
			</a>
		</div>
	</section>

	<section class="bg-mist/70">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
			<ul class="grid gap-px bg-ink/15 sm:grid-cols-2">
				{
					copy.volunteerTasks.map((task) => (
						<li class="bg-snow/80 p-6 sm:p-8">
							<span class="grid size-10 place-items-center bg-aurora/15 text-fjord">
								<Icon name={task.icon} class="size-5" aria-hidden="true" />
							</span>
							<h2 class="mt-4 text-xl font-semibold tracking-tight">{task.title}</h2>
							<p class="mt-2 leading-relaxed text-ink-soft">{task.body}</p>
						</li>
					))
				}
			</ul>
			<div class="mt-12 max-w-2xl border-l-2 border-aurora pl-4">
				<h2 class="text-xl font-semibold tracking-tight">{copy.volunteerHowTitle}</h2>
				<p class="mt-3 leading-relaxed text-ink-soft">{copy.volunteerHow}</p>
			</div>
		</div>
	</section>

	<section id="ilmoittaudu" class="bg-ink/80 text-snow">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
			<h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-snow sm:text-4xl">{copy.volunteerCtaTitle}</h2>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-snow/80">{copy.volunteerCtaLead}</p>
			{
				formReady ? (
					<a
						href={volunteerFormUrl}
						target="_blank"
						rel="noopener"
						class="mt-10 inline-flex min-h-16 items-center gap-3 bg-aurora px-10 text-xl font-semibold text-ink hover:bg-flare focus-visible:outline-snow"
					>
						{copy.volunteerCta}
						<Icon name="lucide:arrow-up-right" class="size-6 shrink-0" aria-hidden="true" />
						<span class="sr-only">{copy.opensInNewTab}</span>
					</a>
				) : (
					<p class="mt-8 max-w-2xl text-sm leading-relaxed text-snow/70">
						{copy.volunteerFormPending} {copy.volunteerEmailLabel}{' '}
						<a class="font-semibold text-aurora hover:text-snow" href={`mailto:${contactEmail}`}>
							{contactEmail}
						</a>
						.
					</p>
				)
			}
		</div>
	</section>
</Layout>
