---
import Button from './Button.astro';
import CtaBand from './CtaBand.astro';
import PageTitle from './PageTitle.astro';
import TickBand from './TickBand.astro';
import Layout from '../layouts/Layout.astro';
import type { SiteCopy } from '../i18n/ui';

interface Props {
	copy: SiteCopy;
}

const { copy } = Astro.props;
---

<Layout copy={copy} title={copy.volunteerNav} description={copy.volunteerDescription}>
	<section>
		<div class="wrap pt-14 pb-16 lg:pt-20 lg:pb-24">
			<PageTitle lines={copy.volunteerTitle} max="7.5rem" />
			<p class="lead mt-8 max-w-2xl">{copy.volunteerLead}</p>
			<div class="mt-8">
				<Button href={copy.volunteerFormUrl} arrow newTabLabel={copy.opensInNewTab}>{copy.volunteerCta}</Button>
			</div>
		</div>
		<TickBand
			heading={copy.volunteerRolesTitle}
			rows={copy.volunteerRoles.map((title) => ({ title }))}
			extra={copy.volunteerRolesExtra}
			footnote={copy.volunteerRolesMore}
		/>
	</section>

	<section class="py-20 lg:py-28">
		<div class="wrap rail">
			<h2 class="h2">{copy.volunteerTasksTitle}</h2>
			<ul class="grid gap-x-10 sm:grid-cols-2">
				{
					copy.volunteerTasks.map((task) => (
						<li class="border-t border-navy/25 pt-5 pb-8">
							<h3 class="text-2xl font-semibold tracking-tight text-blue">{task.title}</h3>
							<p class="mt-2 text-navy/80">{task.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="border-t border-navy/12 pt-20 lg:pt-28">
		<div class="wrap rail pb-14 lg:pb-20">
			<div>
				<h2 class="h2">{copy.volunteerOffersTitle}</h2>
				<ul class="checks mt-8 grid gap-y-3 text-xl font-semibold tracking-tight">
					{copy.volunteerOffers.map((offer) => <li>{offer}</li>)}
				</ul>
			</div>
			<div class="self-start lg:pt-2">
				<h2 class="text-2xl font-semibold tracking-tight text-blue">{copy.volunteerHowTitle}</h2>
				<p class="lead mt-4 max-w-2xl">{copy.volunteerHow}</p>
				<ul class="mt-8 grid max-w-2xl gap-x-10 border-t border-navy/25 pt-6 font-medium sm:grid-cols-2">
					{copy.volunteerFacts.map((fact) => <li class="py-1.5">{fact}</li>)}
				</ul>
			</div>
		</div>
		<CtaBand href={copy.volunteerFormUrl} lines={[copy.volunteerCta]} newTabLabel={copy.opensInNewTab} />
		<div class="h-20 lg:h-28" aria-hidden="true"></div>
	</section>
</Layout>
