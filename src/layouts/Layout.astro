---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import AuroraBackground from '../components/AuroraBackground.astro';
import Button from '../components/Button.astro';
import { translatePath } from '../i18n/pages';
import { contactEmail, githubUrl, locales, type SiteCopy } from '../i18n/ui';
import { mainMenu, sectionUrl, siteGroups } from '../lib/sitemap';
import '../styles/global.css';

interface Props {
	copy: SiteCopy;
	title?: string;
	description?: string;
}

const siteName = 'Arctic AI Association ry';
const { copy, title, description: pageDescription } = Astro.props;
const pageTitle = title ? `${title} – ${siteName}` : siteName;
const description = pageDescription ?? copy.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = getRelativeLocaleUrl(copy.locale);
const routePath = Astro.url.pathname.replace(/^\/(fi|en)/, '').replace(/\/$/, '').replace(/^\//, '');
/* The page the visitor is on, by its Finnish name. Empty on the front page. */
const currentPage = translatePath(routePath, 'fi').split('/')[0];
const menu = mainMenu(copy);
const groups = siteGroups(copy);
const joinUrl = sectionUrl(copy, 'membership');
---

<!doctype html>
<html lang={copy.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#fefefe" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		{
			locales.map((locale) => (
				<link
					rel="alternate"
					hreflang={locale}
					href={getAbsoluteLocaleUrl(locale, translatePath(routePath, locale) || undefined)}
				/>
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={getAbsoluteLocaleUrl('fi', translatePath(routePath, 'fi') || undefined)}
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={copy.ogLocale} />
		{
			locales
				.filter((locale) => locale !== copy.locale)
				.map((locale) => <meta property="og:locale:alternate" content={locale === 'fi' ? 'fi_FI' : 'en_GB'} />)
		}
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<title>{pageTitle}</title>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Organization',
				name: siteName,
				legalName: siteName,
				url: 'https://arcai.fi',
				logo: 'https://arcai.fi/brand/arctic-ai-logo.svg',
				identifier: '3663885-8',
				description,
				inLanguage: copy.htmlLang,
				address: {
					'@type': 'PostalAddress',
					addressLocality: 'Oulu',
					addressCountry: 'FI',
				},
				sameAs: [githubUrl],
			})}
		/>
	</head>
	<body>
		<AuroraBackground />
		<a class="skip-link" href="#sisalto">{copy.skip}</a>
		<div class="relative z-10 flex min-h-screen flex-col">
			<header class="sticky top-0 z-30 bg-white/95">
				<div class="arcai-gradient-line" aria-hidden="true"></div>
				<div class="wrap flex items-center justify-between gap-x-8 py-3">
					<a href={home} class="flex shrink-0 items-center gap-3 text-navy" aria-label={`${siteName}: ${copy.homeLabel}`}>
						<img src="/brand/arctic-ai-logo.svg" alt="" width="1381" height="830" class="h-12 w-auto" />
						<span class="font-semibold tracking-tight max-md:hidden">{siteName}</span>
					</a>
					<nav class="max-lg:hidden" aria-label={copy.navLabel}>
						<ul class="flex gap-x-7 font-medium">
							{
								menu.map((item) => (
									<li>
										<a
											class="menu-link"
											href={item.href}
											aria-current={item.page && item.page === currentPage ? 'page' : undefined}
										>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					<div class="flex items-center gap-x-5">
						<Button href={joinUrl} class="max-sm:hidden">{copy.ctaPrimary}</Button>
						<nav aria-label={copy.languageLabel}>
							<ul class="flex gap-3 font-medium">
								{
									locales.map((locale) => (
										<li>
											<a
												class="menu-link"
												href={getRelativeLocaleUrl(locale, translatePath(routePath, locale) || undefined)}
												hreflang={locale}
												lang={locale}
												aria-current={locale === copy.locale ? 'true' : undefined}
											>
												{locale.toUpperCase()}
											</a>
										</li>
									))
								}
							</ul>
						</nav>
						<details class="site-menu lg:hidden">
							<summary>
								<span class="site-menu__icon" aria-hidden="true"></span>
								{copy.menuLabel}
							</summary>
							<nav class="site-menu__panel" aria-label={copy.navLabel}>
								<ul class="wrap">
									{
										menu.map((item) => (
											<li>
												<a
													href={item.href}
													aria-current={item.page && item.page === currentPage ? 'page' : undefined}
												>
													{item.label}
												</a>
											</li>
										))
									}
								</ul>
								<div class="wrap grid pt-5 sm:hidden">
									<Button href={joinUrl}>{copy.ctaPrimary}</Button>
								</div>
							</nav>
						</details>
					</div>
				</div>
				<div class="h-px bg-navy/12" aria-hidden="true"></div>
			</header>
			<main id="sisalto" class="flex-1">
				<slot />
			</main>
			<footer class="relative overflow-hidden border-t border-navy/12 bg-white">
				<div class="wrap relative z-10 pt-14 pb-10 lg:pt-20">
					<div class="rail">
						<div>
							<a href={home} class="inline-block">
								<img
									src="/brand/arctic-ai-logo.svg"
									alt={copy.logoAlt}
									width="1381"
									height="830"
									class="h-auto w-44"
									loading="lazy"
								/>
							</a>
							<p class="mt-6 max-w-xs font-medium">{copy.tagline}</p>
						</div>
						<nav class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4" aria-label={copy.siteMapLabel}>
							{
								groups.map((group) => (
									<div>
										<h2 class="font-semibold text-blue">{group.heading}</h2>
										<ul class="mt-3 grid gap-2">
											{group.links.map((link) => (
												<li>
													<a
														class="footer-link"
														href={link.href}
														target={link.external ? '_blank' : undefined}
														rel={link.external ? 'noopener' : undefined}
													>
														{link.label}
														{link.external && <span class="sr-only"> {copy.opensInNewTab}</span>}
													</a>
												</li>
											))}
										</ul>
									</div>
								))
							}
						</nav>
					</div>
					<div class="mt-14 grid gap-3 border-t border-navy/12 pt-8 text-[0.9375rem] text-navy/72 lg:max-w-[46rem]">
						<p class="font-semibold text-navy">{siteName}</p>
						<ul class="flex flex-wrap gap-x-6 gap-y-1">
							<li>{copy.businessId}</li>
							<li>{copy.domicile}</li>
							<li>{copy.founded}</li>
						</ul>
						<p>{copy.board}</p>
						<ul class="flex flex-wrap gap-x-6 gap-y-1">
							<li>
								{copy.contactLabel}:{' '}
								<a class="link link--inline" href={`mailto:${contactEmail}`}>{contactEmail}</a>
							</li>
							<li>
								<a class="link link--inline" href={githubUrl}>GitHub</a>
							</li>
						</ul>
						<p class="mt-4">© {new Date().getFullYear()} {siteName}</p>
					</div>
				</div>
				<img
					class="facets right-0 bottom-0 w-[26rem] max-xl:w-[20rem] max-lg:hidden"
					src="/brand/facets-bottom-right.svg"
					alt=""
					width="1360"
					height="1030"
					loading="lazy"
				/>
			</footer>
		</div>
		<script>
			/* Bands and other marked pieces arrive once, when they scroll into view. */
			const marked = document.querySelectorAll('[data-inview]');
			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-in');
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.25 },
				);
				marked.forEach((item) => observer.observe(item));
			} else {
				marked.forEach((item) => item.classList.add('is-in'));
			}

			/* The small-screen menu closes after a choice, on Escape, and on a click outside it. */
			const menu = document.querySelector<HTMLDetailsElement>('.site-menu');
			if (menu) {
				menu.addEventListener('click', (event) => {
					if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
				});
				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && menu.open) {
						menu.open = false;
						menu.querySelector('summary')?.focus();
					}
				});
				document.addEventListener('click', (event) => {
					if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
				});
			}
		</script>
	</body>
</html>
