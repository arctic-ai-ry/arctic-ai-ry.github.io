---
import AuroraBackground from '../components/AuroraBackground.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const siteName = 'Arctic AI Association ry';

const {
	title = 'Etusivu',
	description = 'Testisivu – Arctic AI Association ry -sivuston kehitysversio.',
} = Astro.props;

const pageTitle = title === 'Etusivu' ? siteName : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="fi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<AuroraBackground />
		<div class="relative z-10 flex min-h-screen flex-col">
			<header class="border-b border-slate-800/80 bg-slate-900/60 backdrop-blur">
				<div class="mx-auto flex max-w-3xl items-center px-4 py-4 sm:px-6">
					<a href="/" class="font-semibold tracking-tight text-cyan-400 hover:text-cyan-300">
						{siteName}
					</a>
				</div>
			</header>
			<main class="mx-auto max-w-3xl flex-1 px-4 py-10 sm:px-6">
				<slot />
			</main>
			<footer class="border-t border-slate-800/80">
				<div class="mx-auto max-w-3xl px-4 py-6 text-sm text-slate-400 sm:px-6">
					<p>© {new Date().getFullYear()} {siteName}</p>
				</div>
			</footer>
		</div>
	</body>
</html>
