---
import AuroraBackground from '../components/AuroraBackground.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const siteName = 'Arctic AI Association ry';

const {
	title = siteName,
	description = 'Arctic AI Association ry on oululainen yhdistys, joka vie tekoälyn puheista tuotantoon Pohjois-Suomessa.',
} = Astro.props;

const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#fefefe" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fi_FI" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<title>{pageTitle}</title>
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: siteName,
			legalName: siteName,
			url: 'https://arcai.fi',
			identifier: '3663885-8',
			description,
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Oulu',
				addressCountry: 'FI',
			},
		})} />
	</head>
	<body>
		<AuroraBackground />
		<a class="skip-link" href="#sisalto">Siirry sisältöön</a>
		<div class="relative z-10 flex min-h-screen flex-col">
			<div class="h-1 bg-linear-to-r from-fjord via-aurora to-flare" aria-hidden="true"></div>
			<header class="sticky top-0 z-20 border-b border-ink/10 bg-snow/90 backdrop-blur-md">
				<div
					class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6"
				>
					<a href="/" class="flex items-center gap-3 text-ink">
						<img src="/mark.png" alt="" width="623" height="285" class="h-9 w-auto" />
						<span class="text-sm font-semibold tracking-tight sm:text-base">{siteName}</span>
					</a>
					<nav aria-label="Sivun osiot">
						<ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium text-ink-soft">
							<li><a class="hover:text-ink" href="/#tarkoitus">Tarkoitus</a></li>
							<li><a class="hover:text-ink" href="/#toiminta">Toiminta</a></li>
							<li><a class="hover:text-ink" href="/#kenelle">Kenelle</a></li>
							<li><a class="hover:text-ink" href="/#jasenyys">Jäsenyys</a></li>
						</ul>
					</nav>
				</div>
			</header>
			<main id="sisalto" class="flex-1">
				<slot />
			</main>
			<footer class="border-t border-ink/10">
				<div class="mx-auto max-w-6xl px-4 py-10 text-sm text-ink-soft sm:px-6">
					<p class="font-semibold text-ink">{siteName}</p>
					<p class="mt-2">
						Y-tunnus 3663885-8
						<span aria-hidden="true"> · </span>
						Kotipaikka Oulu
						<span aria-hidden="true"> · </span>
						Perustettu 14.10.2026
					</p>
					<p class="mt-4 max-w-3xl">
						Hallitus: Elina Heikkinen (puheenjohtaja), Janne Ikola, Kari Vierimaa, Teuvo Virsu, Pekka
						Salo ja Satu Nikula. Varajäsen Petteri Heikkinen.
					</p>
					<p class="mt-6">© {new Date().getFullYear()} {siteName}</p>
				</div>
			</footer>
		</div>
	</body>
</html>
